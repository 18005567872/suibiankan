<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Leanback theme for Android TV -->
    <style name="Theme.Leanback" parent="@style/Theme.Leanback">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary_dark</item>
        <item name="android:colorAccent">@color/accent</item>

        <!-- Window settings -->
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>

        <!-- Leanback overrides -->
        <item name="defaultSearchColor">@color/search_orb</item>
        <item name="defaultBrandColor">@color/primary</item>
        <item name="defaultBrandColorDark">@color/primary_dark</item>
    </style>
</resources>
